{
  "name": "zcode-app-launcher",
  "version": "1.1.0",
  "description": "A vertical launcher block for ZCode: open apps or run chained app workflows in one click, with no background process.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "zcode",
    "launcher",
    "app-launcher",
    "electron",
    "asar"
  ],
  "scripts": {
    "check": "node patcher.mjs --check",
    "apply": "node patcher.mjs --apply",
    "revert": "node patcher.mjs --revert",
    "install": "node install.mjs",
    "uninstall": "node uninstall.mjs",
    "test:fixture": "node tests/make-asar.mjs .tmp-test.asar"
  },
  "files": [
    "patcher.mjs",
    "install.mjs",
    "uninstall.mjs",
    "lib",
    "renderer",
    "examples",
    "docs",
    "LICENSE",
    "NOTICE.md",
    "README.md"
  ]
}
